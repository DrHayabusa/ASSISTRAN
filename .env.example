# ===========================================================================
# ASSISTRAN environment configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" in the project root:   cp .env.example .env
# These values are read by the BACKEND only. The frontend NEVER talks to
# Ollama directly — it always calls the backend at /api/translate.
# ===========================================================================

# URL of your Ollama server (no trailing slash).
OLLAMA_URL=http://46.152.253.223:11434

# The model the backend asks Ollama to use for translation.
MODEL_NAME=qwen2.5-coder:32b

# Port the backend Express server listens on.
PORT=3000

# How long (ms) the backend waits for Ollama before giving up.
OLLAMA_TIMEOUT_MS=60000
