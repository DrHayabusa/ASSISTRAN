# ===========================================================================
# ASSISTRAN environment configuration
# ---------------------------------------------------------------------------
# Copy to ".env" in the project root:   cp .env.example .env
# Read by the BACKEND only. The frontend never talks to Ollama/DB/LiveKit
# directly — it always calls the backend (/api, /socket.io).
# ===========================================================================

# ---- Server ----
PORT=3000

# ---- Ollama (translation) ----
OLLAMA_URL=http://46.152.253.223:11434
# The model the backend asks Ollama to use for translation. The backend
# auto-falls-back to an installed model if this one isn't present on the server.
MODEL_NAME=qwen2.5-coder:32b
OLLAMA_TIMEOUT_MS=60000

# ---- MariaDB (users, meetings, chat) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=assistran
DB_PASSWORD=assistran
DB_NAME=assistran
DB_POOL=10

# ---- Auth ----
# CHANGE THIS to a long random string before sharing the server.
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_SEC=604800

# ---- LiveKit (SFU for audio/video; leave blank to disable A/V) ----
# URL the BROWSER connects to. With self-signed TLS on a public IP this is
# typically wss://<PUBLIC_IP>:7443 (terminated by the reverse proxy).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
